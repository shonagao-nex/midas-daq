[Unit]
Description=MIDAS DAQ Status Monitor for daq
Wants=network-online.target
After=network-online.target local-fs.target midas-mhttpd.service

[Service]
Type=simple
User=daq
Group=daq
WorkingDirectory=/home/daq/midas/midas/online

Environment=HOME=/home/daq
Environment=MIDASSYS=/home/daq/midas/midas_src
Environment=MIDAS_EXPTAB=/home/daq/midas/midas/exptab
Environment=MIDAS_EXPT_NAME=daq
Environment=PATH=/home/daq/midas/midas_src/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
UnsetEnvironment=MIDAS_SERVER_HOST MIDAS_SERVER_PORT MIDAS_DIR

ExecStart=/home/daq/midas/midas/online/daq_monitor/bin/daq_monitor -e daq

Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0027

[Install]
WantedBy=multi-user.target
